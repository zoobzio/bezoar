{
  "name": "@bezoar/testing",
  "version": "0.0.3",
  "description": "A bezoar service over PGlite with the migrations and seeds of a build, for tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/bezoar.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bezoar/core": "workspace:*",
    "@bezoar/pglite": "workspace:*",
    "@bezoar/schema": "workspace:*"
  }
}
